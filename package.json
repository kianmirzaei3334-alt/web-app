{
  "name": "web-app",
  "version": "4.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "NOVA_BUILD_MODE=debug node scripts/build.mjs",
    "check": "npm run build && node --check worker.js && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "npm run build && node --test",
    "deploy": "npm run build && wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "KV": {
        "description": "Nova's compatibility and migration store."
      },
      "DB": {
        "description": "Nova's primary D1 database."
      },
      "NOVA_CLAIM_TOKEN": {
        "description": "Optional admin claim token."
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "esbuild": "0.24.2",
    "html-minifier-terser": "^7.2.0",
    "wrangler": "4.116.0"
  }
}
