{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nowa1300",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ba8bcd5b-01c5-487c-a348-a2d5a78e2b54","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "42508958b60d475a962a34b3ad6feb6d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
